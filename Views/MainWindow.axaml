<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AttendanceJournal.ViewModels"
        xmlns:loc="using:AttendanceJournal.ViewModels.Localization"
        x:Class="AttendanceJournal.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding AppTitleText}"
        Width="1120" Height="680"
        MinWidth="860" MinHeight="520">

    <Grid ColumnDefinitions="220,*">
        <!-- ЛІВА НАВІГАЦІЙНА ПАНЕЛЬ -->
        <Border Grid.Column="0"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,0,1,0"
                Padding="12,16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="{Binding NavHeaderText}"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="8,0,0,20" />

                <Button DockPanel.Dock="Bottom"
                        Content="{Binding NavSettingsText}"
                        Command="{Binding NavigateToSettingsCommand}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="10,8" />

                <StackPanel DockPanel.Dock="Top" Spacing="4">
                    <Button Content="{Binding NavJournalText}"
                            Command="{Binding NavigateToJournalCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="10,8" />
                    <Button Content="{Binding NavMonthGridText}"
                            Command="{Binding NavigateToMonthGridCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="10,8" />
                    <Button Content="{Binding NavSummaryText}"
                            Command="{Binding NavigateToSummaryCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="10,8" />
                    <Button Content="{Binding NavGroupsText}"
                            Command="{Binding NavigateToGroupsCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="10,8" />
                    <Button Content="{Binding NavSubjectsText}"
                            Command="{Binding NavigateToSubjectsCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="10,8" />
                    <Button Content="{Binding NavAuditLogText}"
                            Command="{Binding NavigateToAuditLogCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="10,8" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ОСНОВНА РОБОЧА ОБЛАСТЬ -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Border Grid.Row="0"
                    Background="{DynamicResource ErrorBannerBackgroundBrush}"
                    BorderBrush="{DynamicResource ErrorBannerBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,10"
                    Margin="16,16,16,0"
                    IsVisible="{Binding GroupsPage.StartupErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right"
                            Content="{Binding RetryText}"
                            Command="{Binding GroupsPage.RetryStartupCommand}"
                            Margin="12,0,0,0" />
                    <TextBlock Text="{Binding GroupsPage.StartupErrorMessage}"
                               Foreground="{DynamicResource ErrorBannerTextBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <ContentControl Grid.Row="1"
                            Content="{Binding CurrentPage}"
                            IsEnabled="{Binding !GroupsPage.IsInitializing}" />
        </Grid>
    </Grid>
</Window>
